# Superutilisateur PostgreSQL cree au premier demarrage (l'installateur web
# de Nextcloud s'en sert, hote : nextcloud_db)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Domaine : nuage.<DOMAIN> et onlyoffice.<DOMAIN>
DOMAIN=
# Secret partage Nextcloud <-> OnlyOffice : openssl rand -hex 32
JWT_SECRET=
# Suffixe des routeurs Traefik : unique par instance sur un meme Traefik (ex. lamiete, codecommun)
ROUTER_NAME=
# Nom du projet docker compose : UNIQUE par instance sur un meme serveur.
# Vide = nom du dossier. Deux instances avec le meme nom se prennent leurs
# conteneurs (make verifier refuse). A fixer AVANT le premier make up :
# le changer ensuite recree les conteneurs et de nouveaux volumes OnlyOffice.
# COMPOSE_PROJECT_NAME=nextcloud_codecommun

# Versions des images (propres a cette instance). Ne pas les modifier a la main :
#   make update     -> correctifs de ces versions
#   make upgrade    -> Nextcloud, majeure suivante (verifie les apps)
#   make pg-upgrade -> PostgreSQL (dump / restauration)
#   ONLYOFFICE_TAG  -> a la main, puis make update OO_CONFIRME=1
NEXTCLOUD_TAG=33
POSTGRES_TAG=18
ONLYOFFICE_TAG=10.0
# Seulement pour une base PostgreSQL <= 17 (ancienne disposition) :
# POSTGRES_MOUNT=/var/lib/postgresql/data
